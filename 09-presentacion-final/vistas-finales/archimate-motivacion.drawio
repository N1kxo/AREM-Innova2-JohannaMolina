<mxfile host="app.diagrams.net">
  <diagram id="archimate-motivacion" name="Vista de Motivacion - Centro de Contacto (Johanna Molina)">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Vista de Motivacion - Centro de Contacto (Johanna Molina)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c1" value="Driver: Excel compartido sin historial de cambios" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="c2" value="Driver: ausencia de alertas de vencimiento de SLA" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="c3" value="Driver: 8/12 items de cumplimiento normativo en Parcial" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Goal: garantizar trazabilidad y auditabilidad" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="260" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Goal: cumplir indicador institucional de oportunidad (80%)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="260" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Goal: agilizar reportes de gestion semestrales" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="580" y="240" width="260" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Goal: fortalecer gestion de informacion en el marco M365" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="860" y="240" width="260" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Principle: Trazabilidad por diseño" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="260" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Principle: Seguridad y proteccion de datos por diseño" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="410" width="260" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Principle: Evolucion institucional, no reemplazo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="620" y="410" width="260" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Requirement: historial automatico de cambios por caso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="0" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="c12" value="Requirement: alertas automaticas de SLA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="280" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="c13" value="Requirement: reportes semestrales desde vistas de SharePoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="560" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Requirement: procedimiento ARCO documentado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="840" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="c15" value="Requirement: continuidad operativa del Servidor Anexo Unisabana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1120" y="580" width="280" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Work Package: Lista de SharePoint + Power Automate (WP1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#CC6600;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="100" y="750" width="400" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Work Package: Plan de Continuidad BCP/DRP (WP2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#CC6600;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="560" y="750" width="330" height="70" as="geometry"/></mxCell><mxCell id="c18" value="Work Package: ARCO + evaluacion WhatsApp + TRD (WP3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#CC6600;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="950" y="750" width="300" height="70" as="geometry"/></mxCell><mxCell id="c19" value="influye en" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="c1" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="influye en" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="influye en" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c9" target="c7"><mxGeometry r