<mxfile host="app.diagrams.net">
  <diagram id="archimate-motivacion" name="Vista de Motivación - Centro de Contacto, Universidad de La Sabana">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Vista de Motivación - Centro de Contacto, Universidad de La Sabana" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c1" value="Driver: el Excel no deja un registro confiable de quién cambió cada caso" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="c2" value="Driver: no hay alertas antes del vencimiento del SLA" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="c3" value="Driver: reportes semestrales armados a mano" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Driver: 10 de 12 items de cumplimiento normativo en Parcial" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Driver: servidor de Anexo sin plan de recuperación" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Goal: garantizar trazabilidad y auditabilidad" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="260" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Goal: cumplir el indicador de oportunidad (80%)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="260" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Goal: agilizar los reportes de gestión" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="260" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Goal: fortalecer la gestión de información en el marco M365" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="920" y="240" width="560" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Principle: Trazabilidad por diseño" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="560" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Principle: Seguridad y protección de datos por diseño" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="920" y="410" width="260" height="70" as="geometry"/></mxCell><mxCell id="c12" value="Principle: Evolución institucional, no reemplazo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1220" y="410" width="260" height="70" as="geometry"/></mxCell><mxCell id="c13" value="Requirement: historial automático de cambios por caso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Requirement: alertas automáticas de SLA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="c15" value="Requirement: reportes semestrales desde vistas de la Lista" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="620" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Requirement: procedimiento ARCO y evaluación de WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="920" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Requirement: continuidad del Servidor Anexo Unisabana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1220" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="c18" value="Work Package WP1: Lista de SharePoint + Power Automate (fases Mediano y Largo plazo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#CC6600;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="860" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Work Package WP3: ARCO + WhatsApp + TRD (Quick win)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#CC6600;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="920" y="750" width="260" height="70" as="geometry"/></mxCell><mxCell id="c20" value="Work Package WP2: BCP/DRP (Corto plazo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#CC6600;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1220" y="750" width="260" height="70" as="geometry"/></mxCell><mxCell id="c21" value="influye en" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="c1" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="influye en" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="c2" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="influye en" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="influye en" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="influye en" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c12" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c13" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c14" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c15" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c16" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c17" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c18" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c18" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c19" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="realiza" style="endArrow=block;html=1;dashed=1;strokeColor=#2D7D46;fontSize=9;" edge="1" parent="1" source="c20" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell>
