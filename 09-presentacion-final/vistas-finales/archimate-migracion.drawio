        <mxCell id="title" value="Vista de Implementación y Migración - Centro de Contacto, Universidad de La Sabana" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c1" value="Plateau AS-IS: Excel compartido, doble registro, servidor sin respaldo, cumplimiento parcial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="1970" height="70" as="geometry"/></mxCell><mxCell id="c2" value="Gap #1/#3/#4/#5: trazabilidad, doble registro, alertas y DLP" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="0" y="260" width="230" height="70" as="geometry"/></mxCell><mxCell id="c3" value="WP1: Lista de SharePoint + Power Automate (Mediano y Largo plazo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#CC6600;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="210" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Gap #2: servidor sin BCP/DRP" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="570" y="260" width="230" height="70" as="geometry"/></mxCell><mxCell id="c5" value="WP2: Plan de Continuidad BCP/DRP (Corto plazo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#CC6600;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="870" y="260" width="210" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Gap #6/#7/#8: sin ARCO, sin evaluar WhatsApp, sin TRD" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1140" y="260" width="230" height="70" as="geometry"/></mxCell><mxCell id="c7" value="WP3: ARCO + evaluación WhatsApp + TRD (Quick win)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#CC6600;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1440" y="260" width="210" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Gap #9: Gestor de Casos sin respaldo (acción del Quick win, sin WP técnico)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1710" y="260" width="260" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Plateau TO-BE (Taller 7): Lista de SharePoint con historial, alertas de SLA, BCP/DRP probado, cumplimiento documentado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="1970" height="70" as="geometry"/></mxCell><mxCell id="c10" value="asociación" style="endArrow=none;html=1;strokeColor=#555555;fontSize=9;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="asociación" style="endArrow=none;html=1;strokeColor=#555555;fontSize=9;" edge="1" parent="1" source="c1" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="asociación" style="endArrow=none;html=1;strokeColor=#555555;fontSize=9;" edge="1" parent="1" source="c1" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="asociación" style="endArrow=none;html=1;strokeColor=#555555;fontSize=9;" edge="1" parent="1" source="c1" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="asociación" style="endArrow=none;html=1;strokeColor=#555555;fontSize=9;" edge="1" parent="1" source="c2" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="asociación" style="endArrow=none;html=1;strokeColor=#555555;fontSize=9;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="asociación" style="endArrow=none;html